<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.2.0</Version>
    <AssemblyName>VSMixer</AssemblyName>
    <Product>VSMixer</Product>
    <Description>Reprodutor multitrack para apresentações ao vivo.</Description>
    <Authors>VSMixer</Authors>
    <ApplicationIcon>Assets/Brand/vsmixer-logo.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <AvaloniaResource Include="Assets\Brand\**" />
    <AvaloniaResource Include="Assets\Icons\**\*.svg" />
    <Content Include="Assets\Pads-Continuos\**\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Voz-Guia\**\*.mp3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) ">
    <None Include="Native\win-x64\bass.dll" Link="bass.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\win-x64\bass_fx.dll" Link="bass_fx.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))) ">
    <None Include="Native\osx\libbass.dylib" Link="libbass.dylib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\osx\libbass_fx.dylib" Link="libbass_fx.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateMacArm64NativeDependencies"
          BeforeTargets="PrepareForBuild;Publish"
          Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <Error Text="Publicação osx-arm64 bloqueada: adicione uma versão ARM64 oficial de libbass_fx.dylib em Native/osx-arm64 antes de publicar."
           Condition="!Exists('Native/osx-arm64/libbass_fx.dylib')" />
  </Target>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' And Exists('Native/osx-arm64/libbass_fx.dylib')">
    <None Include="Native\osx\libbass.dylib" Link="libbass.dylib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\osx-arm64\libbass_fx.dylib" Link="libbass_fx.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Fx" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Mix" Version="4.0.2" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
  </ItemGroup>
</Project>
