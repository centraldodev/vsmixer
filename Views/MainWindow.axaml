<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VSMixer.ViewModels"
        xmlns:controls="using:VSMixer.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="VSMixer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="VSMixer"
        MinWidth="860"
        MinHeight="540"
        Background="#070b11">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M7,5 L11,5 L11,19 L7,19 Z M14,5 L18,5 L18,19 L14,19 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRewind">M19,5 L10,12 L19,19 Z M9,5 L0,12 L9,19 Z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M7,7 L17,7 M10,7 L10,5 L14,5 L14,7 M9,10 L9,18 M12,10 L12,18 M15,10 L15,18 M8,7 L9,20 L15,20 L16,7</StreamGeometry>
        <StreamGeometry x:Key="IconMute">M4,10 L8,10 L13,5 L13,19 L8,14 L4,14 Z M17,9 L22,14 M22,9 L17,14</StreamGeometry>
        <StreamGeometry x:Key="IconSolo">M6,13 A6,6 0,0 1,18 13 M6,13 L6,18 L9,18 L9,12 L6,12 Z M15,12 L18,12 L18,18 L15,18 Z</StreamGeometry>
        <StreamGeometry x:Key="IconVolume">M5,11 L9,11 L14,6 L14,18 L9,13 L5,13 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPan">M5,12 L19,12 M8,9 L5,12 L8,15 M16,9 L19,12 L16,15</StreamGeometry>
        <StreamGeometry x:Key="IconMetronome">M8,21 L16,21 L14,7 L10,7 Z M12,7 L12,3 M9,15 L15,11 M7,21 L17,21</StreamGeometry>
        <StreamGeometry x:Key="IconGuideVoice">M12,14 A3,3 0,0 0,15 11 L15,7 A3,3 0,0 0,9 7 L9,11 A3,3 0,0 0,12 14 M6,11 A6,6 0,0 0,18 11 M12,17 L12,21 M9,21 L15,21</StreamGeometry>
        <StreamGeometry x:Key="IconPad">M4,8 L8,5 L12,8 L16,5 L20,8 L20,17 L4,17 Z M8,5 L8,17 M12,8 L12,17 M16,5 L16,17</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- Base button: secondary/default look used everywhere unless overridden by a class -->
        <Style Selector="Button, ToggleButton">
            <Setter Property="Background" Value="#131a25"/>
            <Setter Property="Foreground" Value="#c9d7e6"/>
            <Setter Property="BorderBrush" Value="#293a4d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover, ToggleButton:pointerover">
            <Setter Property="Background" Value="#1b2634"/>
            <Setter Property="BorderBrush" Value="#3a4f68"/>
        </Style>
        <Style Selector="Button:pressed, ToggleButton:pressed">
            <Setter Property="Opacity" Value="0.78"/>
        </Style>
        <Style Selector="Button:disabled, ToggleButton:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="ToggleButton:checked:not(.channel-toggle)">
            <Setter Property="Background" Value="#2f6fed"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5c92ff"/>
        </Style>

        <!-- Primary: the one accent CTA per screen/section (Adicionar, Sessao, Fechar, etc.) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2f6fed"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5c92ff"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#4a83ff"/>
            <Setter Property="BorderBrush" Value="#7fabff"/>
        </Style>

        <!-- Ghost: chromeless buttons for the top bar (MENU, +) -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8fa8c3"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="#131a25"/>
            <Setter Property="BorderBrush" Value="#293a4d"/>
        </Style>

        <!-- Icon-only square buttons -->
        <Style Selector="Button.icon-button, ToggleButton.icon-button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Mini square buttons: stepper (-/+) and flyout chevrons -->
        <Style Selector="Button.mini">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Transport play/pause -->
        <Style Selector="Button.transport-play">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="#2f6fed"/>
            <Setter Property="BorderBrush" Value="#5c92ff"/>
        </Style>
        <Style Selector="Button.transport-play:pointerover">
            <Setter Property="Background" Value="#4a83ff"/>
            <Setter Property="BorderBrush" Value="#7fabff"/>
        </Style>

        <!-- Project tabs -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#6fa2ff"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.tab:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9dc0ff"/>
        </Style>
        <Style Selector="Button.tab-close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#5c6f87"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button.tab-close:pointerover">
            <Setter Property="Background" Value="#2a1319"/>
            <Setter Property="Foreground" Value="#ff8085"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox.top-input">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Channel strip Mute/Solo: DAW-standard red/yellow feedback when active.
             FluentTheme's default ToggleButton template paints :checked with the
             system accent color regardless of Background, so this uses a plain
             Border template to make Background/BorderBrush setters actually apply. -->
        <Style Selector="ToggleButton.channel-toggle">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#0b111a"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.mute-toggle:checked">
            <Setter Property="Background" Value="#e5484d"/>
            <Setter Property="BorderBrush" Value="#ff7a7f"/>
        </Style>
        <Style Selector="ToggleButton.solo-toggle:checked">
            <Setter Property="Background" Value="#e6b800"/>
            <Setter Property="BorderBrush" Value="#ffd23f"/>
        </Style>

        <Style Selector="Slider.volume-slider">
            <Setter Property="Foreground" Value="#2f7dff"/>
            <Setter Property="Background" Value="#1d2a38"/>
        </Style>
        <Style Selector="Slider.pan-slider">
            <Setter Property="Foreground" Value="#21c2a8"/>
            <Setter Property="Background" Value="#22313d"/>
        </Style>
        <Style Selector="TextBox, NumericUpDown, ComboBox">
            <Setter Property="Background" Value="#111823"/>
            <Setter Property="Foreground" Value="#f6fbff"/>
            <Setter Property="BorderBrush" Value="#253244"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,58,152,*,42">
        <Border Grid.Row="0" Background="#080d14" BorderBrush="#162231" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="42,112,*,38" Margin="5,0">
                <Button Grid.Column="0" Classes="ghost" Width="42" Height="30" Padding="0" Content="MENU" FontSize="10" FontWeight="Bold">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Abrir projeto" Click="OpenProjectMenuItem_Click"/>
                            <MenuItem Header="Salvar" Click="SaveProjectMenuItem_Click"/>
                            <MenuItem Header="Salvar como" Click="SaveProjectAsMenuItem_Click"/>
                            <MenuItem Header="Configuracao de audio" Command="{Binding OpenAudioSettingsModalCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Grid.Column="1" Text="PROJETOS" Foreground="#8fa8c3" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4">
                    <ItemsControl ItemsSource="{Binding ProjectTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectTabViewModel">
                                <Border Background="#111823" BorderBrush="#253244" BorderThickness="1" CornerRadius="8">
                                    <Grid ColumnDefinitions="*,22">
                                        <Button Classes="tab"
                                                Content="{Binding DisplayName}"
                                                Command="{Binding $parent[Window].DataContext.SelectProjectTabCommand}"
                                                CommandParameter="{Binding}"
                                                MinWidth="92"/>
                                        <Button Grid.Column="1"
                                                Classes="tab-close"
                                                Content="x"
                                                Command="{Binding $parent[Window].DataContext.CloseProjectTabCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="3" Classes="icon-button ghost" Content="+" FontSize="16" FontWeight="Bold" Command="{Binding NewProjectTabCommand}" ToolTip.Tip="Novo projeto"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#060b12" BorderBrush="#172334" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="46,34,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="10,8" ColumnSpacing="10">
                <Button Grid.Column="0" Classes="transport-play" Command="{Binding TogglePlaybackCommand}" ToolTip.Tip="{Binding PlayPauseText}">
                    <Grid Width="18" Height="18">
                        <PathIcon Data="{StaticResource IconPlay}" Foreground="White" Width="18" Height="18" IsVisible="{Binding IsNotPlaying}"/>
                        <PathIcon Data="{StaticResource IconPause}" Foreground="White" Width="18" Height="18" IsVisible="{Binding IsPlaying}"/>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Classes="icon-button" Command="{Binding RewindCommand}" ToolTip.Tip="Voltar">
                    <PathIcon Data="{StaticResource IconRewind}" Foreground="#dbe7f5" Width="16" Height="16"/>
                </Button>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TIMER" Foreground="#778ba2" FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentTime}" Foreground="White" FontSize="17" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="COMPASSO" Foreground="#778ba2" FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="{Binding BarClock}" Foreground="White" FontSize="17" FontWeight="Bold"/>
                </StackPanel>
                <Border Grid.Column="4" Background="#121924" BorderBrush="#253244" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,58" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBlock Text="DETECTADO" Foreground="#7f92aa" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Classes="top-input" Text="{Binding DetectedBpmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <Border Grid.Column="6" Background="#121924" BorderBrush="#253244" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,58" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBlock Text="BPM" Foreground="#8295aa" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Classes="top-input" Text="{Binding PlaybackBpmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <Border Grid.Column="7" Background="#121924" BorderBrush="#253244" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,64" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBlock Text="COMPASSO" Foreground="#8295aa" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TimeSignatures}" SelectedItem="{Binding SelectedTimeSignature}" Width="64" Height="30"/>
                    </Grid>
                </Border>
                <Border Grid.Column="8" Background="#121924" BorderBrush="#253244" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,64" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBlock Text="GRADE" Foreground="#8295aa" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding GridOptions}" SelectedItem="{Binding SelectedGrid}" Width="64" Height="30"/>
                    </Grid>
                </Border>
                <Border Grid.Column="9" Background="#121924" BorderBrush="#253244" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="mini" Command="{Binding ChangePitchCommand}" CommandParameter="-1" Content="-"/>
                        <TextBlock Text="{Binding PitchOffset, StringFormat='{}{0} st'}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Classes="mini" Command="{Binding ChangePitchCommand}" CommandParameter="1" Content="+"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="10" Background="#121924" BorderBrush="#253244" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="28,24" ColumnSpacing="4">
                        <ToggleButton Classes="icon-button" IsChecked="{Binding MetronomeEnabled}" ToolTip.Tip="Metronomo">
                            <PathIcon Data="{StaticResource IconMetronome}" Foreground="#dbe7f5" Width="17" Height="17"/>
                        </ToggleButton>
                        <Button Grid.Column="1" Classes="mini" Content="v" ToolTip.Tip="Controles do metronomo">
                            <Button.Flyout>
                                <Flyout>
                                    <Border Width="220" Background="#101823" BorderBrush="#2e4056" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                            <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                                                <TextBlock Text="VOL" Foreground="#91a7bf" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding MetronomeVolume}"/>
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnDefinitions="42,*" ColumnSpacing="10">
                                                <TextBlock Text="PAN" Foreground="#91a7bf" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding MetronomePan}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Column="11" Background="#121924" BorderBrush="#253244" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="28,24" ColumnSpacing="4">
                        <ToggleButton Classes="icon-button" IsChecked="{Binding GuideVoiceEnabled}" ToolTip.Tip="Voz guia">
                            <PathIcon Data="{StaticResource IconGuideVoice}" Foreground="#dbe7f5" Width="17" Height="17"/>
                        </ToggleButton>
                        <Button Grid.Column="1" Classes="mini" Content="v" ToolTip.Tip="Controles da voz guia">
                            <Button.Flyout>
                                <Flyout>
                                    <Border Width="220" Background="#101823" BorderBrush="#2e4056" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                            <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                                                <TextBlock Text="VOL" Foreground="#91a7bf" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding GuideVoiceVolume}"/>
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnDefinitions="42,*" ColumnSpacing="10">
                                                <TextBlock Text="PAN" Foreground="#91a7bf" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding GuideVoicePan}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Column="12" Background="#121924" BorderBrush="#253244" BorderThickness="1" CornerRadius="8" Padding="4" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="6" VerticalAlignment="Center">
                        <ToggleButton Classes="icon-button" IsChecked="{Binding PadContinuousEnabled}" ToolTip.Tip="Pad continuo">
                            <PathIcon Data="{StaticResource IconPad}" Foreground="#dbe7f5" Width="17" Height="17"/>
                        </ToggleButton>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding PadNotes}" SelectedItem="{Binding SelectedPadNote}" Width="78" Height="30"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="22,102,28" Background="#07101a">
            <ItemsControl Grid.Row="0" ItemsSource="{Binding TimeMarkers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#122233" BorderBrush="#28394c" BorderThickness="0,0,1,1" Padding="6,4">
                            <TextBlock Text="{Binding}" Foreground="#71b9ff" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:WaveformView Grid.Row="1" Peaks="{Binding WaveformPeaks}" Progress="{Binding PlaybackProgress}" PointerPressed="WaveformView_PointerPressed"/>
            <Grid Grid.Row="2">
                <controls:SectionRulerView Sections="{Binding SessionRegions}" TotalMeasures="176"/>
                <Button Classes="primary" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="12,4" FontSize="11" Command="{Binding OpenAddSessionModalCommand}" Content="Sessao"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="42,*" Background="#080d14">
            <Border Grid.Row="0" BorderBrush="#162231" BorderThickness="0,0,0,1" Padding="10,5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} TRACKS'}" Foreground="#44617f" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="ImportTracksButton" Classes="primary" Click="ImportTracksButton_Click" Content="+ ADICIONAR" Padding="14,6" FontSize="11"/>
                    <Button Content="DRIVE" Padding="14,6" FontSize="11"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#7289a3" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tracks}" Margin="10,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackChannelViewModel">
                            <Border Width="104" Height="520" Background="#101720" BorderBrush="#243245" BorderThickness="1" CornerRadius="6" Padding="7">
                                <Grid RowDefinitions="28,22,*,36,44,28">
                                    <Grid ColumnDefinitions="*,28">
                                        <TextBlock Text="{Binding NumberLabel, StringFormat='# {0}'}" Foreground="#67809a" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="icon-button" Command="{Binding $parent[Window].DataContext.RemoveTrackCommand}" CommandParameter="{Binding}" ToolTip.Tip="Excluir track">
                                            <PathIcon Data="{StaticResource IconTrash}" Foreground="#95a8bd" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="-3dB" Foreground="#8aa0b7" FontSize="10" HorizontalAlignment="Center"/>
                                    <Grid Grid.Row="2" ColumnDefinitions="12,*" Margin="0,2,0,0">
                                        <controls:LevelMeter Level="{Binding Level}" Width="7"/>
                                        <Border Grid.Column="1" Width="44" HorizontalAlignment="Center" Background="#0b121b" BorderBrush="#1d2b3b" BorderThickness="1" CornerRadius="8" Padding="4,10">
                                            <Grid RowDefinitions="18,*">
                                                <PathIcon Data="{StaticResource IconVolume}" Foreground="#73a8ff" Width="16" Height="16" HorizontalAlignment="Center"/>
                                                <Slider Grid.Row="1" Classes="volume-slider" Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding Volume}" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="3" Background="#07151a" BorderBrush="#173c42" BorderThickness="1" CornerRadius="7" Padding="5,2" VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="14,*,14" ColumnSpacing="3">
                                            <TextBlock Text="L" Foreground="#63dcca" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <Grid Grid.Column="1" RowDefinitions="10,*">
                                                <PathIcon Data="{StaticResource IconPan}" Foreground="#21c2a8" Width="20" Height="10" HorizontalAlignment="Center"/>
                                                <Slider Grid.Row="1" Classes="pan-slider" Minimum="-1" Maximum="1" Value="{Binding Pan}" Height="16"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="R" Foreground="#63dcca" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="4" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding FooterTitle}" Foreground="White" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileName}" Foreground="#7890aa" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <ToggleButton Classes="channel-toggle mute-toggle" IsChecked="{Binding IsMuted}" ToolTip.Tip="Mute">
                                            <PathIcon Data="{StaticResource IconMute}" Foreground="#dbe7f5" Width="17" Height="17"/>
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="1" Classes="channel-toggle solo-toggle" IsChecked="{Binding IsSolo}" ToolTip.Tip="Solo">
                                            <PathIcon Data="{StaticResource IconSolo}" Foreground="#dbe7f5" Width="17" Height="17"/>
                                        </ToggleButton>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="4" Background="#070b11" BorderBrush="#172334" BorderThickness="0,1,0,0" Padding="14,5">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Text="MASTER" Foreground="#9d71ff" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="-3dB" Foreground="#50647a" FontSize="10" VerticalAlignment="Center"/>
                <Slider Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding MasterVolume}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="+0,0 dB" Foreground="#9fb1c5" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.RowSpan="5" Background="#99000000" IsVisible="{Binding IsAddSessionModalOpen}">
            <Border Width="470" Background="#101823" BorderBrush="#2e4056" BorderThickness="1" CornerRadius="8" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="Nova sessao" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Nome" Foreground="#91a7bf" FontWeight="Bold" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding SessionNameOptions}" SelectedItem="{Binding NewSessionName}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Compasso inicial" Foreground="#91a7bf" FontWeight="Bold" FontSize="11"/>
                            <NumericUpDown Minimum="1" Maximum="999" Value="{Binding NewSessionStartMeasure}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Compasso final" Foreground="#91a7bf" FontWeight="Bold" FontSize="11"/>
                            <NumericUpDown Minimum="1" Maximum="999" Value="{Binding NewSessionEndMeasure}"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="#0b121b" BorderBrush="#1e2b3c" BorderThickness="1" CornerRadius="7" Padding="12">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Copiar tamanho de sessao" Foreground="#91a7bf" FontWeight="Bold" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding SessionCopyOptions}" SelectedItem="{Binding SelectedSessionCopySource}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#e6eef8"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Command="{Binding CloseAddSessionModalCommand}" Content="Cancelar"/>
                        <Button Classes="primary" Command="{Binding AddSessionCommand}" Content="Adicionar"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="5" Background="#99000000" IsVisible="{Binding IsAudioSettingsModalOpen}">
            <Border Width="620" MaxHeight="620" Background="#101823" BorderBrush="#2e4056" BorderThickness="1" CornerRadius="8" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <TextBlock Text="Configuracao de audio e MIDI" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <StackPanel Grid.Row="1" Spacing="14">
                        <Border Background="#0b121b" BorderBrush="#1e2b3c" BorderThickness="1" CornerRadius="7" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Saida de audio" Foreground="#91a7bf" FontWeight="Bold"/>
                                <ComboBox ItemsSource="{Binding AudioOutputDevices}"
                                          SelectedItem="{Binding SelectedAudioOutputDevice}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#e6eef8"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#0b121b" BorderBrush="#1e2b3c" BorderThickness="1" CornerRadius="7" Padding="12">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Controlador MIDI" Foreground="#91a7bf" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding IsMidiControllerEnabled}" Content="Habilitar"/>
                                </Grid>

                                <ComboBox Grid.Row="1"
                                          ItemsSource="{Binding MidiControllerDevices}"
                                          SelectedItem="{Binding SelectedMidiController}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#e6eef8"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid Grid.Row="2" ColumnDefinitions="120,*" ColumnSpacing="10">
                                    <TextBlock Text="Banco" Foreground="#91a7bf" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding MidiControlBanks}"
                                              SelectedItem="{Binding SelectedMidiControlBank}"
                                              HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Command="{Binding OpenAudioSettingsModalCommand}" Content="Atualizar"/>
                        <Button Classes="primary" Command="{Binding CloseAudioSettingsModalCommand}" Content="Fechar"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
